<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet: integração Gemini IA (Sprint 4) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Galeria de imagens: seleção de avatar (Sprint 1) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventaAi">

        <!-- ========== Sprint 1: Login é a tela de entrada ========== -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="Login"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cadastro de novo perfil -->
        <activity
            android:name=".ui.login.CadastroPerfilActivity"
            android:exported="false"
            android:label="Criar Perfil"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de perfil -->
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:label="Meu Perfil"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard (não é mais launcher; é aberto após login) -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- Cadastro de novo item -->
        <activity
            android:name=".ui.cadastro.CadastroActivity"
            android:exported="false"
            android:label="Adicionar Alimento"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhes e edição de item -->
        <activity
            android:name=".ui.detalhes.DetalhesActivity"
            android:exported="false"
            android:label="Detalhes do Item"
            android:windowSoftInputMode="adjustResize" />

        <!-- Histórico de consumo e descarte -->
        <activity
            android:name=".ui.historico.HistoricoActivity"
            android:exported="false"
            android:label="Histórico" />

        <!-- Chef IA — geração de receitas -->
        <activity
            android:name=".ui.chefIA.ChefIAActivity"
            android:exported="false"
            android:label="Chef IA" />

    </application>

</manifest>