<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet: integração Gemini IA -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Galeria de imagens: seleção de avatar -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventaAi">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.InventaAi.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login — não é o launcher -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:label="Login"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cadastro de novo perfil -->
        <activity
            android:name=".ui.login.CadastroPerfilActivity"
            android:exported="false"
            android:label="Criar Perfil"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de perfil -->
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:label="Meu Perfil"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tarefa 2: launchMode="singleTop" nas três Activities do BottomNav. -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Cadastro de novo item (não faz parte do ciclo singleTop do BottomNav) -->
        <activity
            android:name=".ui.cadastro.CadastroActivity"
            android:exported="false"
            android:label="Adicionar Alimento"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhes e edição de item -->
        <activity
            android:name=".ui.detalhes.DetalhesActivity"
            android:exported="false"
            android:label="Detalhes do Item"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tarefa 2: launchMode="singleTop" + Tarefa 1: indicador do BottomNav corrigido via onResume(). -->
        <activity
            android:name=".ui.historico.HistoricoActivity"
            android:exported="false"
            android:label="Histórico"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.chefIA.ChefIAActivity"
            android:exported="false"
            android:label="Chef IA"
            android:launchMode="singleTop" />

    </application>

</manifest>