<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão de internet para a Sprint 4 (integração com Gemini IA) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventaAi">

        <!-- Tela principal (launcher) -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cadastro de novo item -->
        <activity
            android:name=".ui.cadastro.CadastroActivity"
            android:exported="false"
            android:label="Adicionar Alimento"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhes e edição de item -->
        <activity
            android:name=".ui.detalhes.DetalhesActivity"
            android:exported="false"
            android:label="Detalhes do Item"
            android:windowSoftInputMode="adjustResize" />

        <!-- Histórico de consumo e descarte -->
        <activity
            android:name=".ui.historico.HistoricoActivity"
            android:exported="false"
            android:label="Histórico" />

        <!-- Chef IA — geração de receitas -->
        <activity
            android:name=".ui.chefIA.ChefIAActivity"
            android:exported="false"
            android:label="Chef IA" />

    </application>

</manifest>