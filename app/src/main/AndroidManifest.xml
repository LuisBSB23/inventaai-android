<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet: integração Gemini IA (Sprint 4) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Galeria de imagens: seleção de avatar (Sprint 1) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventaAi">

        <!-- ========== Sprint 1: Login é a tela de entrada ========== -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="Login"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cadastro de novo perfil -->
        <activity
            android:name=".ui.login.CadastroPerfilActivity"
            android:exported="false"
            android:label="Criar Perfil"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de perfil -->
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:label="Meu Perfil"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard (não é mais launcher; é aberto após login) -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- Cadastro de novo item -->
        <activity
            android:name=".ui.cadastro.CadastroActivity"
            android:exported="false"
            android:label="Adicionar Alimento"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhes e edição de item -->
        <activity
            android:name=".ui.detalhes.DetalhesActivity"
            android:exported="false"
            android:label="Detalhes do Item"
            android:windowSoftInputMode="adjustResize" />

        <!-- Histórico de consumo e descarte -->
        <activity
            android:name=".ui.historico.HistoricoActivity"
            android:exported="false"
            android:label="Histórico" />

        <!--
            Chef IA — geração de receitas.

            BUG CORRIGIDO (launchMode):
            O launchMode padrão ("standard") criava uma NOVA instância do ChefIAActivity
            a cada vez que o usuário navegava de volta para essa tela, disparando
            gerarReceita() e uma nova chamada à API Gemini em cada visita.
            Com poucas sessões de uso, isso esgotava a cota diária da API (RPD),
            causando o erro "Limite de requisições atingido" mesmo sem o limite real
            ter sido atingido no projeto.

            "singleTop": se o ChefIAActivity já estiver no topo da back stack,
            o Android reutiliza a instância existente (chama onNewIntent, não onCreate),
            evitando chamadas duplicadas à API. Uma nova instância só é criada se a
            Activity não estiver no topo — comportamento correto e esperado.
        -->
        <activity
            android:name=".ui.chefIA.ChefIAActivity"
            android:exported="false"
            android:label="Chef IA"
            android:launchMode="singleTop" />

    </application>

</manifest>