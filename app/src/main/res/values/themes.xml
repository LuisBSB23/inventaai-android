<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Tema Base — Culinary Vitality (Light) ===== -->
    <style name="Theme.InventaAi" parent="Theme.Material3.Light.NoActionBar">

        <!-- Cores primárias -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <!-- Cores secundárias -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>

        <!-- Cores terciárias -->
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>

        <!-- Erro -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>

        <!-- Background e superfícies -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>

        <!-- Contorno -->
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>

        <!-- BottomNav: força indicador verde (corrige laranja do tema padrão) -->
        <item name="bottomNavigationStyle">@style/Widget.InventaAi.BottomNav.Style</item>

        <!-- Status bar transparente / clara -->
        <item name="android:statusBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Tipografia: Inter via fontFamily global -->
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <!-- ===== Estilo: Botão Pill (Primário) ===== -->
    <style name="Widget.InventaAi.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">50dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- ===== Estilo: Botão Pill (Contorno — Erro/Remover) ===== -->
    <style name="Widget.InventaAi.Button.Pill.Outlined.Error" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">50dp</item>
        <item name="strokeColor">@color/colorError</item>
        <item name="android:textColor">@color/colorError</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ===== Estilo: TextInputLayout Pill (campos arredondados) ===== -->
    <style name="Widget.InventaAi.TextInputLayout.Pill" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">50dp</item>
        <item name="boxCornerRadiusTopEnd">50dp</item>
        <item name="boxCornerRadiusBottomStart">50dp</item>
        <item name="boxCornerRadiusBottomEnd">50dp</item>
        <item name="boxStrokeColor">@color/colorOutlineVariant</item>
        <item name="boxBackgroundColor">@color/colorSurfaceContainerLowest</item>
        <item name="hintTextColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">@color/colorOnSurfaceVariant</item>
    </style>

    <!-- ===== Estilo: MaterialCardView (neumorphic suave) ===== -->
    <style name="Widget.InventaAi.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorSurfaceContainerLowest</item>
        <item name="strokeColor">@color/colorSurfaceContainerHighest</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== Estilo: Card menor (itens de lista) ===== -->
    <style name="Widget.InventaAi.Card.Small" parent="Widget.InventaAi.Card">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- ===== Estilo: Chip de Status ===== -->
    <style name="Widget.InventaAi.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">50dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
    </style>

    <!-- ===== Estilo: BottomNavigationView (corrige cor laranja → verde) ===== -->
    <style name="Widget.InventaAi.BottomNav.Style" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.InventaAi.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
    </style>

    <style name="Widget.InventaAi.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorPrimaryContainer</item>
    </style>

    <!-- ===== Tema da Splash Screen ===== -->
    <style name="Theme.InventaAi.Splash" parent="Theme.InventaAi">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>