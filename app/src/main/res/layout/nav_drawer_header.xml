<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingTop="56dp"
    android:paddingBottom="20dp"
    android:background="@color/colorSurface">

    <FrameLayout
        android:id="@+id/frameDrawerAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_primary_container"
        android:layout_marginBottom="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDrawerAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.InventaAi.Circle"
            android:contentDescription="Avatar" />

        <TextView
            android:id="@+id/tvDrawerIniciais"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="@font/inter_bold"
            android:textSize="22sp"
            android:textColor="@color/colorPrimary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDrawerNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:textSize="17sp"
        android:textColor="@color/colorOnSurface"
        android:text="Usuário" />

    <TextView
        android:id="@+id/tvDrawerIdAbreviado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="@color/colorOnSurfaceVariant"
        android:visibility="gone"
        android:text="ID: ..." /> <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="20dp"
    android:background="?attr/colorOutlineVariant" />

</LinearLayout>