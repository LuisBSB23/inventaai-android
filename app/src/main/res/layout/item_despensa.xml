<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorSurfaceContainerHighest"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Linha superior: CheckBox (modo seleção) + Ícone + Spacer + Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/checkboxItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:clickable="false"
                android:focusable="false"
                android:buttonTint="@color/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:checked="true" />

            <!--
                TAREFA #3 — Ícone circular da categoria:
                O FrameLayout recebe backgroundTintList dinâmico via CategoryColorHelper.
                O ImageView recebe imageTintList dinâmico (cor "on container").
                android:backgroundTint aqui é o fallback usado no editor/preview;
                em runtime o DespensaAdapter sobrescreve via setBackgroundTintList.
            -->
            <FrameLayout
                android:id="@+id/flIconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_primary_container"
                android:backgroundTint="@color/colorPrimaryContainer">

                <ImageView
                    android:id="@+id/ivItemIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_food_icon"
                    android:src="@drawable/ic_cat_outros"
                    android:transitionName="transition_item_icon"
                    android:tint="@color/colorOnPrimaryContainer" />
            </FrameLayout>

            <!-- Espaço flexível -->
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Badge de dias restantes -->
            <TextView
                android:id="@+id/tvExpiryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAllCaps="false"
                android:textColor="@color/colorOnPrimary"
                android:textSize="11sp"
                tools:text="3 dias" />
        </LinearLayout>

        <!-- Nome do item -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/colorOnSurface"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"
            tools:text="Leite Integral" />

        <!-- Quantidade e unidade -->
        <TextView
            android:id="@+id/tvItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"
            tools:text="1 L" />

        <!-- Barra de frescor -->
        <ProgressBar
            android:id="@+id/progressFreshness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="70"
            android:progressDrawable="@drawable/progress_freshness" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>