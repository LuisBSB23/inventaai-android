<?xml version="1.0" encoding="utf-8"?>
<!--
    item_despensa.xml
    Card de item da despensa (usado no RecyclerView do Dashboard).
    Dimensões: largura fixa 160dp (modo horizontal) ou match_parent (modo vertical).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItem"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorSurfaceContainerHighest"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Linha superior: ícone + badge de alerta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Ícone circular do item -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_primary_container">

                <ImageView
                    android:id="@+id/ivItemIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_food_icon"
                    android:src="@drawable/ic_nav_pantry"
                    android:tint="@color/colorPrimary" />
            </FrameLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Badge de dias restantes -->
            <TextView
                android:id="@+id/tvExpiryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAllCaps="false"
                android:textColor="@color/colorOnPrimary"
                android:textSize="11sp"
                tools:text="3 dias" />
        </LinearLayout>

        <!-- Nome do item -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/colorOnSurface"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            tools:text="Leite Integral" />

        <!-- Quantidade e unidade -->
        <TextView
            android:id="@+id/tvItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"
            tools:text="1 L" />

        <!-- Barra de frescor (freshness meter) -->
        <ProgressBar
            android:id="@+id/progressFreshness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="70"
            android:progressDrawable="@drawable/progress_freshness" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
