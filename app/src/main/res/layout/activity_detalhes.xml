<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── Barra superior com botão Voltar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp">

            <ImageButton
                android:id="@+id/btnVoltarDetalhes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_arrow"
                android:tint="?attr/colorOnSurface"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:textSize="17sp"
                android:textColor="?attr/colorOnSurface"
                android:text="Editar Item" />

            <!-- Espaçador simétrico ao botão para centralizar o título -->
            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />

        </LinearLayout>

        <!-- Drag Handle -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Chips de Status e Categoria -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatus"
                    style="@style/Widget.InventaAi.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/expires_today"
                    app:chipBackgroundColor="?attr/colorErrorContainer"
                    app:chipIcon="@drawable/ic_nav_history"
                    app:chipIconTint="?attr/colorError"
                    android:textColor="?attr/colorOnErrorContainer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCategoria"
                    style="@style/Widget.InventaAi.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="Hortifruti"
                    app:chipBackgroundColor="?attr/colorSurfaceVariant"
                    android:textColor="?attr/colorOnSurface" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Imagem circular do alimento -->
            <FrameLayout
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivItemImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_food_icon"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_nav_pantry"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.InventaAi.Circle"
                    app:strokeColor="?attr/colorSurface"
                    app:strokeWidth="4dp" />
            </FrameLayout>

            <!-- Nome do item -->
            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_extrabold"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="32sp"
                android:layout_marginBottom="8dp"
                tools:text="Abacate Hass" />

            <!-- Data de validade (label) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@null"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvAddedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    tools:text="Validade: 22/05/2026" />
            </LinearLayout>

            <!-- Sprint 13: Campo editável de data de validade com DatePickerDialog -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDataValidadeDetalhes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="?attr/colorPrimary"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconTint="?attr/colorPrimary"
                app:endIconContentDescription="Selecionar data"
                android:hint="Data de Validade">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDataValidadeDetalhes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:inputType="none"
                    tools:text="22/05/2026" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- STEPPER de Quantidade -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_card_neu"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_marginBottom="32dp">

                <ImageButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="@string/decrease_quantity"
                    android:src="@drawable/ic_decrease"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:minWidth="120dp">

                    <TextView
                        android:id="@+id/tvQuantidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extrabold"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="40sp"
                        android:maxLines="1"
                        android:adjustViewBounds="false"
                        tools:text="2" />

                    <TextView
                        android:id="@+id/tvUnidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        tools:text="UNIDADES" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="@string/increase_quantity"
                    android:src="@drawable/ic_increase"
                    android:tint="?attr/colorPrimary" />

            </LinearLayout>

            <!--
                TAREFA #2 — Botões reorganizados verticalmente:
                - btnSalvar no TOPO, largura total, estilo Pill primário.
                - btnRemover ABAIXO, estilo OutlinedButton em cor de erro, altura 48dp.
                - Espaçamento de 12dp entre eles.
                - O AlertDialog em Java NÃO foi alterado.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- Botão Salvar — topo, largura total, estilo primário -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvar"
                    style="@style/Widget.InventaAi.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/btn_save_item"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <!-- Botão Remover — abaixo, estilo outlined, cor de erro, 48dp -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemover"
                    style="@style/Widget.InventaAi.Button.Pill.Outlined.Error"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp"
                    android:text="Remover"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>