<?xml version="1.0" encoding="utf-8"?>
<!--
    Sprint 20 — Item da lista de pré-visualização de importação CSV.
    Itens inválidos exibem fundo de erro e ícone de alerta.
    Itens válidos permitem edição inline da categoria.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:strokeColor="@color/colorSurfaceContainerHighest"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Ícone de alerta (visível apenas para itens inválidos) -->
        <ImageView
            android:id="@+id/ivAlerta"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_saude_alerta"
            android:tint="?attr/colorError"
            android:visibility="gone"
            android:contentDescription="Item inválido"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nome do item -->
        <TextView
            android:id="@+id/tvNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivAlerta"
            tools:text="Arroz Branco"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- Linha: Quantidade + Unidade -->
        <TextView
            android:id="@+id/tvQuantidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tvNome"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="2 kg"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- Validade -->
        <TextView
            android:id="@+id/tvValidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tvNome"
            app:layout_constraintStart_toEndOf="@id/tvQuantidade"
            tools:text="Val: 31/12/2026"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- Spinner de categoria (editável inline) -->
        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner_outline"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvQuantidade"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Mensagem de erro inline (visível apenas para itens inválidos) -->
        <TextView
            android:id="@+id/tvErro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="12sp"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Quantidade inválida — será importada como 1"
            tools:visibility="visible"
            xmlns:tools="http://schemas.android.com/tools" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>