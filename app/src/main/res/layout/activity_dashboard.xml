<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_dashboard.xml
    Tela principal do InventaAí — Design: Culinary Vitality
    Estrutura: CoordinatorLayout > AppBarLayout + NestedScrollView + FAB + BottomNavigationView
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.dashboard.DashboardActivity">

    <!-- ======================== TOP APP BAR ======================== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="24dp">

            <!-- Botão Menu (hambúrguer) -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_menu"
                android:src="@drawable/ic_nav_pantry"
                android:tint="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título InventaAí -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/app_name"
                android:textColor="@color/colorPrimary"
                android:textSize="22sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivAvatar"
                app:layout_constraintStart_toEndOf="@id/btnMenu"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Avatar do usuário -->
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@string/cd_profile"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_nav_pantry"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ======================== CONTEÚDO PRINCIPAL (scrollável) ======================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="180dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <!-- ===== SEÇÃO 1: Saudação ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="@string/greeting_prefix"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="34sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tvGreetingUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="@string/greeting_user"
                    android:textColor="@color/colorPrimary"
                    android:textSize="34sp"
                    android:layout_marginTop="-4dp" />

                <TextView
                    android:id="@+id/tvGreetingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/greeting_subtitle"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- ===== SEÇÃO 2: Card Saúde da Despensa ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPantryHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorSurfaceContainerHighest"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/llHealthText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivHealthIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:letterSpacing="0.05"
                            android:text="@string/pantry_health_label"
                            android:textAllCaps="true"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvHealthValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/pantry_health_value"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="20sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Ícone circular decorativo -->
                    <FrameLayout
                        android:id="@+id/ivHealthIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_primary_container"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_chef"
                            android:tint="@color/colorPrimary" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SEÇÃO 3: Vencendo Logo ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/expiring_soon_title"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/see_all"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- RecyclerView horizontal — itens vencendo logo -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExpiringSoon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_despensa"
                    tools:itemCount="3" />
            </LinearLayout>

            <!-- ===== SEÇÃO 4: Todos os itens da Despensa ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/pantry_items_title"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp" />

                <!-- RecyclerView vertical — lista principal -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPantryItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_despensa"
                    tools:itemCount="5" />

                <!-- Estado vazio -->
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="@string/no_items"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:paddingVertical="32dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ======================== FAB: Gerar Receita ======================== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateRecipe"
        style="@style/Widget.InventaAi.Button.Pill"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="88dp"
        android:text="@string/generate_recipe"
        android:textSize="18sp"
        app:icon="@drawable/ic_nav_chef"
        app:iconGravity="textStart" />

    <!-- ======================== BOTTOM NAVIGATION ======================== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        app:itemActiveIndicatorStyle="@style/Widget.InventaAi.BottomNav.ActiveIndicator"
        app:itemIconTint="@color/selector_nav_item"
        app:itemTextColor="@color/selector_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>