<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.historico.HistoricoActivity">

    <!-- Histórico: indicador de carregamento -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorColor="@color/colorPrimary"
        tools:visibility="visible" />

    <!-- ======================== TOP APP BAR ======================== -->
    <!--
        TAREFA #4 — Fix tvToolbarTitulo flutuante:
        O TextView do título agora está DENTRO do ConstraintLayout da AppBar.
        Removido o app:layout_anchor do final do arquivo.
        Constraints: lado esquerdo preso ao btnBack, lado direito na margem.
        maxLines="1" + ellipsize="end" evitam quebra de linha.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back_arrow"
                android:tint="?attr/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título fixo — não usa mais app:layout_anchor -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ======================== CONTEÚDO ======================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <!-- Título e subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/title_history"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/subtitle_history"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!--
                TAREFA #1 — ChipGroup de filtros:
                Horizontal, abaixo do subtítulo, com singleSelection=true.
                Cada chip terá a contagem atualizada dinamicamente pelo Java.
                O chip selecionado dispara o reload do RecyclerView.
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodos"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Todos" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipConsumido"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consumido" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDescartado"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descartado" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUsadoReceita"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usado em receita" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- RecyclerView da linha do tempo -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_historico"
                tools:itemCount="4" />

            <LinearLayout
                android:id="@+id/layoutEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="40dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_empty_history"
                    android:contentDescription="@null"
                    android:alpha="0.75"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/empty_history_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/empty_history_message"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="32dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ======================== BOTTOM NAVIGATION ======================== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        app:itemIconTint="@color/selector_nav_item"
        app:itemTextColor="@color/selector_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <TextView
        android:id="@+id/tvToolbarTitulo"
        android:layout_width="104dp"
        android:layout_height="36dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_bold"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="?attr/colorPrimary"
        android:textSize="22sp"
        app:layout_anchor="@+id/appBarLayout4"
        app:layout_anchorGravity="center" />

    <!--
        TAREFA #4 — REMOVIDO: o TextView flutuante com app:layout_anchor
        que causava sobreposição com o botão Voltar foi eliminado.
        O título agora está dentro da AppBar (tvToolbarTitulo acima).
    -->

</androidx.coordinatorlayout.widget.CoordinatorLayout>