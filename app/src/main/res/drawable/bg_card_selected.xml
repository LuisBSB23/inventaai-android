<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Borda verde primária, 2dp -->
    <stroke
        android:width="2dp"
        android:color="#006D36" />

    <!-- Fundo levemente tintado de verde para destacar a seleção -->
    <solid android:color="#0D006D36" />

    <!-- Raio dos cantos igual ao MaterialCardView (16dp) -->
    <corners android:radius="16dp" />

</shape>