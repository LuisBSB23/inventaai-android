<?xml version="1.0" encoding="utf-8"?>
<!-- bg_card_neu com ripple effect — cor primária a 20% de alpha -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33006D36">

    <!-- Conteúdo visual do card (idêntico ao original) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurfaceContainerLowest" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/colorSurfaceContainerHighest" />
        </shape>
    </item>

    <!-- Máscara: garante que o ripple respeite os cantos arredondados -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</ripple>